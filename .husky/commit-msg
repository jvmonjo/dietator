#!/usr/bin/env sh

commit_msg_file="$1"
commit_title="$(head -n 1 "$commit_msg_file")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([A-Za-z0-9._-]+\))?!?: .+'

if ! printf '%s' "$commit_title" | grep -Eq "$pattern"; then
  echo "Invalid commit title: $commit_title"
  echo "Use Conventional Commits, e.g. feat(expenses): add location filter"
  exit 1
fi
